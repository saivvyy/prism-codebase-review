# ==============================================================================
# PRism Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the FastAPI backend:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. Never commit .env to version control.
# 2. Never place live production secrets or tokens in template files.
# 3. SUPABASE_SERVICE_ROLE_KEY and GITHUB_CLIENT_SECRET are strictly backend-only.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="Engineering Memory API"
VERSION="0.1.0"
ENVIRONMENT=development
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# CORS Configuration
# Allowed frontend origins (JSON list or comma-separated strings)
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ------------------------------------------------------------------------------
# Supabase Configuration (Canonical Application State & Storage)
# Required for persistent repository metadata, PR reviews, and audit records.
# Note: In local development, an in-memory/fallback mode is used if omitted.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# CRITICAL: Backend-only. Grants administrative access for migrations and service operations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Hindsight Integration (Semantic Engineering Memory Engine)
# Required for semantic memory retention and institutional knowledge recall.
# If omitted or unconfigured, an in-memory local fallback operates automatically.
# ------------------------------------------------------------------------------
HINDSIGHT_API_KEY=your-hindsight-api-key
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_DEFAULT_BANK_ID=engineering_memory

# ------------------------------------------------------------------------------
# Groq Inference (LLM Review Engine)
# Required for generating explainable architectural reviews and fix diffs.
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_LIGHTWEIGHT_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# GitHub Integration & OAuth
# Required for repository synchronization, PR inspection, and developer sign-in.
# ------------------------------------------------------------------------------
# GitHub OAuth App credentials (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Session signing key used for encrypting session cookies and state tokens
SESSION_SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-32-bytes

# Optional developer token fallback (used for local offline testing if OAuth is skipped)
# GITHUB_TOKEN=your_optional_personal_access_token_here

# Optional webhook secret (used only if configuring inbound GitHub repository webhooks)
# GITHUB_WEBHOOK_SECRET=your_optional_webhook_secret
